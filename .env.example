# --- Backend Configuration ---
# Port the Node.js Express server runs on
PORT=5000

# SQLite database file path (e.g. database.sqlite or a persistent volume directory)
DATABASE_PATH=database.sqlite

# JWT Secret key for secure authentication signing
JWT_SECRET=super_secret_ultimate_warrior_key_2026_998124

# Node execution environment (development | production)
NODE_ENV=development


# --- Frontend Configuration ---
# The endpoint URL pointing to the backend API
# (Vite variables must be prefixed with VITE_)
VITE_API_URL=http://localhost:5000/api
